{
    "name": "harvest-slack-bot",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx src/index.ts",
        "start": "node --enable-source-maps dist/index.js",
        "build": "tsup src/index.ts --format esm --outDir dist --sourcemap",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "db:seed": "tsx src/db/seed.ts"
    },
    "dependencies": {
        "@date-fns/tz": "^1.4.1",
        "@slack/bolt": "^3.18.0",
        "axios": "^1.7.7",
        "better-sqlite3": "^9.2.2",
        "date-fns": "^3.6.0",
        "cronstrue": "^2.32.0",
        "dotenv": "^16.4.5",
        "drizzle-orm": "^0.44.7",
        "node-cron": "^4.2.1"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "drizzle-kit": "^0.31.5",
        "tsup": "^8.5.0",
        "tsx": "^4.20.6",
        "typescript": "^5.6.3"
    }
}